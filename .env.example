# Veridell — no-cost-first Cloudflare Pages configuration.
# The default is Workers AI only. On Cloudflare Free, requests stop when the
# included daily allocation is exhausted; this configuration never upgrades
# the plan or silently sends work to a paid provider.
# Local Ollama mode is configured in the chat UI and runs on the reader's device.

# Cloudflare Pages → Settings → Functions → Workers AI binding: name it AI.
# The wrangler.toml file already declares this binding for local development.
WORKERS_AI_MODEL=@cf/zai-org/glm-4.7-flash
AI_PROVIDER=workers-ai

# Paid AI is disabled by default. Do not set these for the zero-cost setup.
# To deliberately enable paid OpenRouter requests, BOTH settings are required:
#   ENABLE_PAID_AI=true
#   AI_PROVIDER=openrouter
# Optional fallback to paid requests ALSO requires ENABLE_PAID_AI=true:
#   ALLOW_PAID_FALLBACK=true
ENABLE_PAID_AI=false
ALLOW_PAID_FALLBACK=false

# Optional OpenRouter keys are unused unless ENABLE_PAID_AI=true and the
# provider is explicitly selected. Keep actual keys in encrypted secrets only.
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=
OPENROUTER_API_KEY_6=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODELS=
OPENROUTER_MODEL_TIER=cheap
CHAT_MODEL=

SITE_ORIGIN=https://veridell.pages.dev
