# Veridell — Cloudflare Pages redirects.
#
# The app is one document behind a hash router. These keep the short addresses
# people type working, and give the crawlable directories their trailing slash.

/ask            /#/ask            302
/explore        /#/explore        302
/today          /#/today          302
/saved          /#/bookmarks      302
/sources        /#/sources        302

# The old sitemap name was submitted to Search Console once; keep it alive.
/site.xml       /sitemap.xml      301
