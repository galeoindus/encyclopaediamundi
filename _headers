# Veridell — Cloudflare Pages headers.
#
# The site loads nothing from a third party except the Wikimedia APIs it reads
# and the fonts the operating system already has, so the policy can be strict.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.wikimedia.org https://*.wikipedia.org https://www.cloudflare.com https://openrouter.ai https://ollama.com; connect-src 'self' https://*.wikipedia.org https://*.wikimedia.org https://*.wikidata.org http://127.0.0.1:11434 http://localhost:11434; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/styles/*
  Cache-Control: public, max-age=3600

/src/*
  Cache-Control: public, max-age=600

/assets/*
  Cache-Control: public, max-age=86400
