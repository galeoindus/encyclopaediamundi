# Veridell — one editor, whatever the editor is.
#
# The tree is mostly hand-written CSS, ES modules and HTML with a strong house
# style: two-space indent, LF endings, a final newline, no trailing spaces. The
# generated files (the CSS bundles, sitemap.xml, assets/version.json) are written
# by scripts and must not be hand-edited, but they follow the same rules.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,mjs,json,webmanifest,css,html,yml,yaml,toml}]
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# A markdown file may legitimately end a line with two spaces: it is a hard
# line break, and stripping it silently reflows the document.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Generated: a diff here means a script ran, not that someone typed.
[assets/css/bundle-*.css]
insert_final_newline = true
